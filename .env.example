# ---------------------------------------------------------------------------
# day2day · variables de entorno
#
# Todo vive en Supabase. Vercel (o cualquier hosting estático) solo necesita
# estas cuatro, que Vite inlinea en el bundle. NUNCA pongas secretos en VITE_*.
# ---------------------------------------------------------------------------
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase → Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=
# Las únicas dos cuentas que pueden entrar: "Nombre:correo,Nombre:correo".
# Deben existir ya en Supabase → Authentication → Users.
VITE_ACCOUNTS=Miguel:miguel@correo.com,Karen:karen@correo.com
# Clave pública VAPID (Web Push). Está en .vapid-keys.json → publicKey.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Secretos de la Edge Function `push`
# (Supabase → Edge Functions → Secrets, o `supabase secrets set`; no van aquí)
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY   = la misma clave pública
# VAPID_PRIVATE_KEY  = .vapid-keys.json → privateKey
# VAPID_SUBJECT      = mailto:tu@correo.com
