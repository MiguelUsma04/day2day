{
  "expo": {
    "name": "day2day",
    "slug": "day2day",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "day2day",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#2563EB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miguelusma.day2day"
    },
    "android": {
      "package": "com.miguelusma.day2day",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "day2day",
      "shortName": "day2day",
      "lang": "es",
      "themeColor": "#2563EB",
      "backgroundColor": "#F8FAFC",
      "display": "standalone",
      "orientation": "portrait",
      "description": "Tu cronograma diario: arma tu rutina y cúmplela, desde que te levantas hasta que te duermes."
    },
    "plugins": ["expo-font"]
  }
}
